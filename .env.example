ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

SYMBOLS=AAPL,MSFT,TSLA

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=stock_ticks

# Poll once per hour by default.
# Adjust only if your Alpha Vantage entitlement allows a higher frequency.
POLL_INTERVAL_SECONDS=3600

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stocks
POSTGRES_USER=stocks_user
POSTGRES_PASSWORD=your_postgres_password

PGADMIN_EMAIL=admin@local.com
PGADMIN_PASSWORD=your_pgadmin_password

SPARK_CHECKPOINT=/tmp/spark-checkpoints